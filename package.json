{
  "name": "website-inliner",
  "version": "3.0.0",
  "description": "Fetch a webpage and inline all external scripts and stylesheets into a single HTML file",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "keywords": [
    "inline",
    "scripts",
    "stylesheets",
    "css",
    "html",
    "web"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "lru-cache": "^11.5.3",
    "request-filtering-agent": "^3.2.1"
  }
}
